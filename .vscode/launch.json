{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Launch Current",
			"skipFiles": ["<node_internals>/**"],
			"program": "${file}",
			"outFiles": ["${workspaceFolder}/**/*.js"]
		},
		{
			"name": "Debug server side / fresh content",
			"type": "node-terminal",
			"request": "launch",
			"command": "yarn copy-content && yarn sass && yarn dev",
			"env": {
				"NODE_OPTIONS": "--inspect"
			}
		},
		{
			"name": "Debug server-side",
			"type": "node-terminal",
			"request": "launch",
			"command": "yarn dev",
			"env": {
				"NODE_OPTIONS": "--inspect"
			}
		},
		{
			"name": "Debug Build",
			"type": "node-terminal",
			"request": "launch",
			"command": "yarn build",
			"env": {
				"NODE_OPTIONS": "--inspect"
			}
		},
		{
			"name": "Copy Mel Content",
			"type": "node-terminal",
			"request": "launch",
			"command": "npx ts-node src/scripts/copy-content --clean --project ../mels-loop-content",
			"env": {
				"NODE_OPTIONS": "--inspect",
				"YASPP_PROJECT_ROOT": "../mels-loop-content"
			}
		},
		{
			"name": "Init c-temp-mels-loop",
			"type": "node-terminal",
			"request": "launch",
			"command": "npx ts-node ./src/scripts/init-yaspp --project C:\\\\temp\\\\mels-loop",
			"env": {
				"NODE_OPTIONS": "--inspect"
			}
		},
		
		{
			"name": "Init Mel",
			"type": "node-terminal",
			"request": "launch",
			"command": "npx ts-node ./src/scripts/init-yaspp --project ../mels-loop-content",
			"env": {
				"NODE_OPTIONS": "--inspect"
			}
		},
		{
			"name": "Next.js full stack",
			"type": "node-terminal",
			"request": "launch",
			"command": "yarn dev",
			"serverReadyAction": {
				"pattern": "Local:.+(https?://.+)",
				"uriFormat": "%s",
				"action": "debugWithChrome"
			}
		}

	]
}