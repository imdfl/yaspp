{
	"$schema": "yaspp-bindings.schema.json",
	"bindings": [
		{
			"text-container": {},
			"text": {
				"classes": [
					"document-text"
				]
			},
			"header": {
				"classes": [
					"hcontainer",
					"container-inverse-color",
					"container-inverse-text"
				],
				"site-horizontal-menu": {
					"classes": [
					],
					"main-menu": {
						"sections": {
							"classes": [ "hcontainer" ]
					},
						"item": {
							"button": {
								"classes": {
									"add": [
										"ml-color-text-inverse"
									]
								}
							}
						}
					},
					"submenu": {
						"item": {
							"list": {
								"classes": [ "container-controls-color" ],
								"list-item": {
									"classes": {
										"add": [ "ml-color-controls-level1"]
									}
								}
							}
						}
					}
				},
				"text": {
					"classes": {
						"remove": [
							"document-text"
						],
						"add": [
							"header-text"
						]
					}
				},
				"locale-select": {
					"classes": {
						"remove": [
							"document-text"
						],
						"add": [
							"header-text"
						]
					}
				},
				"button": {
					"classes": {
						"add": [
							"header-text"
						]
					}
				}
			},
			"button": {
				"classes": [
					"container-center",
					"control",
					"control-hover"
				]
			},
			"nav": {
				"classes": [
					"rabak"
				]
			},
			"menu": {
				"classes": [
					"ml-color-background-controls",
					"ml-color-controls"
				],
				"menu-item": {
					"classes": [
						"vcontainer-left"
					],
					"button": {
						"classes": {
							"add": [
								"control-hover"
							],
							"remove": [
								"control"
							]
						}
					}
				}
			}
		}
	]
}