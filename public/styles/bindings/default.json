{
	"$schema": "yaspp-bindings.schema.json",
	"bindings": [
		{
			"text": {
				"classes": [ "document-text"]
			},
			"header": {
				"classes": [ "hcontainer" ],
				"text": {
					"classes": {
						"remove": ["document-text"],
						"add": ["header-text"]
					}
				},
				"locale-select": {
					"classes": {
						"remove": ["document-text"],
						"add": ["header-text"]
					}
				},
				"button": {
					"classes": {
						"add": ["header-text"]
					}
				}
			},
			"button": {
				"classes": [ "container-center", "control" ]
			},
			"nav": {
				"classes": [ "rabak" ]
			},
			"menu": {
				"menu-item": {
					"classes": [ "vcontainer-left" ],
					"button": {
						"classes": {
							"add": ["control-hover"],
							"remove": [ "control" ]
						}
					}
				}
			}
		}
	]
}