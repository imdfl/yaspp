{
	"$schema": "yaspp-bindings.schema.json",
	"bindings": [
		{
			"text-container": {},
			"text": {
				"classes": [
					"document-text"
				]
			},
			"header": {
				"classes": [
					"header-container"
				],
				"site-horizontal-menu": {
					"classes": [],
					"main-menu": {
						"sections": {
							"classes": [
								"hcontainer"
							]
						},
						"item": {
							"button": {
								"classes": {
									"add": [
										"ml-color-text-inverse"
									]
								}
							}
						}
					},
					"submenu": {
						"item": {
							"list": {
								"classes": [
									"container-controls-color"
								],
								"list-item": {
									"classes": {
										"add": [
											"ml-color-controls-level1"
										]
									}
								}
							}
						}
					}
				},
				"theme": {
					"classes": [
						"ml-color-text-inverse"
					]
				},
				"drawer": {
					"classes": [
						"ml-color-background-controls"
					],
					"menu": {
						"classes": [
							"vcontainer", "menu-container"
						]
					}
				},
				"text": {
					"classes": {
						"remove": [
							"document-text"
						],
						"add": [
							"header-text"
						]
					}
				},
				"locale-select": {
					"classes": {
						"remove": [
							"document-text"
						],
						"add": [
							"header-text"
						]
					}
				},
				"button": {
					"classes": {
						"add": [
							"header-text"
						]
					}
				}
			},
			"footer": {
				"classes": [
					"footer-container"
				]
			},
			"button": {
				"classes": [
					"hcontainer justify-center",
					"control",
					"control-hover"
				]
			},
			"nav": {
				"classes": [
					"rabak"
				]
			},
			"menu": {
				"classes": [
					"menu-container"
				],
				"menu-item": {
					"classes": [
						"vcontainer", "justify-start"
					],
					"button": {
						"classes": {
							"add": [
								"control-hover"
							],
							"remove": [
								"control"
							]
						}
					}
				}
			},
			"dialog": {
				"toolbar": {
					"classes": [
						"container-inverse-color"
					],
					"text": {
						"classes": {
							"add": [
								"ml-color-text-inverse"
							]
						}
					},
					"button": {
						"classes": {
							"add": [
								"ml-color-text-inverse"
							]
						}
					}
				}
			},
			"code": {
				"classes": ["ml-font-family-code"]
			},
			"code-block": {
				"classes": ["ml-font-family-code", "ml-color-background-level2"]
			},
			"figure": {
				"classes": [
					"ml-color-background-level2"
				]	
			},
			"figure-codeblock": {
				"classes": {
					"add": [ "no-border"]
				}
			},
			"figure-no-border": {
				"classes": {
					"add": [ "no-border"]
				}
			},
			"date-format": {
				"classes": [ "ml-font-size-sm"]
			}
		}
	]
}