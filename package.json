{
  "name": "yaspp",
  "version": "0.1.1",
  "description": "Yet Another Self Publishing Platform",
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "publishing",
    "platform",
    "authoring"
  ],
  "homepage": "https://melsloop.com",
  "bugs": {
    "url": "https://github.com/tomerlichtash/mels-loop/issues",
    "email": "aboutmelsloop@gmail.com"
  },
  "contributors": [
    {
      "name": "Tomer Lichtash",
      "email": "tomerlichtash@gmail.com",
      "url": "https://github.com/tomerlichtash"
    },
    {
      "name": "(David *)Frenkiel",
      "email": "dfl.github@gmail.com",
      "url": "https://github.com/imdfl"
    }
  ],
  "import/resolver": {
    "typescript": {}
  },
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "build": "next build",
    "prebuild": "yarn sass && yarn copy-content --clean",
    "dev-old": "next dev",
    "dev-css": "bash scripts/dev.sh",
    "sass": "npx sass public/styles public/yaspp/styles",
    "sassqwatch": "npx sass --watch public/styles public/yaspp/styles",
    "swatch": "yarn sassqwatch",
    "update-yaspp": "yarn remove yaspp-types && yarn add yaspp-types@git+https://github.com/imdfl/yaspp-types.git",
    "dev": "next dev",
    "start": "next start",
    "build:sitemap": "next-sitemap",
    "health": "yarn format:check && yarn lint && yarn lint:style && yarn test:unit && yarn test:e2e",
    "lint": "eslint . -f codeframe",
    "lint:style": "stylelint --allow-empty-input \"**/*.{css,scss}\"",
    "test:unit": "jest",
    "test:unit:coverage": "jest --coverage",
    "test:e2e": "NODE_OPTIONS='--no-warnings' playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "playwright test",
    "test:e2e:ci:local": "circleci local execute e2e",
    "sass:debug": "sass --load-path=src -wc .",
    "sass:clean": "find src -type f \\( -name \"*.css\" -o -name \"*.css.map\" \\) -exec rm {} +",
    "upload": "npx ts-node scripts/upload-files.ts",
    "init-yaspp": "npx ts-node src/scripts/init-yaspp",
    "copy-content": "npx ts-node src/scripts/copy-content"
  },
  "dependencies": {
    "@radix-ui/react-form": "^0.1.8",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@sendgrid/mail": "8.1.0",
    "date-fns": "^3.3.1",
    "formik": "2.4.5",
    "gray-matter": "4.0.3",
    "json5": "^2.2.3",
    "lnk": "^1.1.0",
    "lodash.orderby": "4.6.0",
    "next": "16.2.6",
    "next-axiom": "1.1.1",
    "next-optimized-classnames": "^1.0.2",
    "next-themes": "0.2.1",
    "next-translate": "^3.1.3",
    "normalize.css": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-modern-drawer": "1.2.2",
    "tmp": "0.2.1",
    "yaspp-types": "git+https://github.com/imdfl/yaspp-types.git",
    "yup": "1.3.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/env": "16.2.6",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/addon-onboarding": "^10.4.1",
    "@storybook/blocks": "8.6.14",
    "@storybook/nextjs": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@storybook/test": "8.6.15",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/dateformat": "5.0.2",
    "@types/grecaptcha": "^3.0.7",
    "@types/jest": "^29.5.12",
    "@types/node": "20.11.16",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/rimraf": "^3.0.2",
    "@types/tmp": "0.2.6",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-formatter-codeframe": "7.32.1",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-storybook": "^10.4.1",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expect-message": "^1.1.3",
    "next-router-mock": "^0.9.12",
    "next-sitemap": "4.2.3",
    "next-translate-plugin": "^3.1.3",
    "path": "0.12.7",
    "rimraf": "5",
    "sass": "^1.100.0",
    "simple-markdown": "0.7.3",
    "storybook": "^10.4.1",
    "style-loader": "^3.3.4",
    "stylelint": "^17.12.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.3.3"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "resolutions": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "yarn@4.15.0"
}
